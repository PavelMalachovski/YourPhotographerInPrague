# Copy to .env and set strong, unique values:  cp .env.example .env
# Generate a password with:  openssl rand -base64 24
# .env is git-ignored — never commit real credentials.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=change-me-user

# Published ports are bound to 127.0.0.1 only (see docker-compose.yaml)
WORDPRESS_PORT=8888
PHPMYADMIN_PORT=3001
